# ============================================================
# APPLICATION
# ============================================================

APP_NAME=ai-incident-management
APP_ENV=development
LOG_LEVEL=INFO


# ============================================================
# AZURE OPENAI - LLM
# Used by all LangGraph agents
# ============================================================

AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_DEPLOYMENT=<your-chat-model-deployment>
AZURE_OPENAI_API_VERSION=2024-10-21

AZURE_OPENAI_TEMPERATURE=0
AZURE_OPENAI_MAX_TOKENS=4096
AZURE_OPENAI_TIMEOUT=60
AZURE_OPENAI_MAX_RETRIES=3


# ============================================================
# AZURE OPENAI - EMBEDDINGS
# Used by RAG / ChromaDB / Azure AI Search
# ============================================================

AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<your-embedding-deployment>

# Same Azure OpenAI endpoint/key can normally be used
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-10-21


# ============================================================
# LOCAL CHROMADB
# Used when Azure AI Search is not configured
# ============================================================

CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=incidents

RAG_TOP_K=5


# ============================================================
# AZURE AI SEARCH
#
# If these three values are configured, RAG uses:
#
#   Hybrid Search
#   Vector Search
#   Keyword Search
#   Semantic Reranking
#   Metadata Filtering
#
# If they are NOT configured:
#
#   Local ChromaDB
#   Semantic similarity search only
# ============================================================

AZURE_SEARCH_ENDPOINT=https://<your-search-resource>.search.windows.net
AZURE_SEARCH_API_KEY=<your-search-api-key>
AZURE_SEARCH_INDEX_NAME=incidents

AZURE_SEARCH_CONTENT_FIELD=content
AZURE_SEARCH_VECTOR_FIELD=content_vector
AZURE_SEARCH_SEMANTIC_CONFIGURATION=default


# ============================================================
# MICROSOFT GRAPH API
# Used for:
#
# 1. Create Teams war room
# 2. Add stakeholders
# 3. Retrieve transcript
# 4. Send stakeholder email
# ============================================================

GRAPH_TENANT_ID=<azure-tenant-id>
GRAPH_CLIENT_ID=<graph-application-client-id>
GRAPH_CLIENT_SECRET=<graph-client-secret>

# User/mailbox used to send stakeholder emails
GRAPH_MAILBOX_USER=<service-account-email>


# ============================================================
# MICROSOFT GRAPH API - OPTIONAL SETTINGS
# ============================================================

GRAPH_API_BASE_URL=https://graph.microsoft.com/v1.0

GRAPH_TOKEN_TIMEOUT=60
GRAPH_API_TIMEOUT=60
GRAPH_API_MAX_RETRIES=3


# ============================================================
# SERVICENOW
#
# Used for:
#
# 1. Create incident
# 2. Query CMDB
# 3. Query CIs
# 4. Query CI relationships
# ============================================================

SERVICENOW_INSTANCE_URL=https://<your-instance>.service-now.com

SERVICENOW_CLIENT_ID=<servicenow-oauth-client-id>
SERVICENOW_CLIENT_SECRET=<servicenow-oauth-client-secret>


# ============================================================
# SERVICENOW API SETTINGS
# ============================================================

SERVICENOW_API_BASE_URL=/api/now

SERVICENOW_API_TIMEOUT=60
SERVICENOW_API_MAX_RETRIES=3


# ============================================================
# SERVICENOW TABLES
# ============================================================

SERVICENOW_INCIDENT_TABLE=incident

SERVICENOW_CMDB_CI_TABLE=cmdb_ci

SERVICENOW_CMDB_RELATIONSHIP_TABLE=cmdb_rel_ci


# ============================================================
# RAG METADATA FIELD NAMES
#
# These must match the fields in Azure AI Search.
# ============================================================

RAG_ASSIGNMENT_GROUP_FIELD=assignment_group
RAG_INCIDENT_DATETIME_FIELD=incident_datetime


# ============================================================
# TEST CONFIGURATION
#
# Use ONLY for integration testing.
# Do not use production recipients/resources here.
# ============================================================

TEST_STAKEHOLDER_EMAILS=test.user1@company.com,test.user2@company.com

TEST_EMAIL_RECIPIENTS=test.user@company.com

TEST_GRAPH_TEAM_ID=<test-team-id>
TEST_GRAPH_CHANNEL_ID=<test-channel-id>

TEST_SERVICENOW_CALLER_ID=<test-caller-sys-id>
TEST_SERVICENOW_ASSIGNMENT_GROUP=<test-assignment-group>